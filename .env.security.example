# Configuration de sécurité pour le système de réinitialisation de mot de passe

# Durée de validité des tokens de réinitialisation (en minutes)
# Par défaut : 60 minutes
PASSWORD_RESET_TOKEN_EXPIRE=60

# Délai entre les demandes de réinitialisation (en secondes)
# Par défaut : 60 secondes
PASSWORD_RESET_THROTTLE=60

# Nombre maximum de tentatives de réinitialisation par IP par heure
# Par défaut : 5 tentatives
PASSWORD_RESET_MAX_ATTEMPTS=5

# Activer les notifications par email lors des changements de mot de passe
# Par défaut : true
PASSWORD_CHANGE_NOTIFICATIONS=true

# Activer l'audit trail des tentatives de réinitialisation
# Par défaut : true
PASSWORD_RESET_AUDIT_LOG=true

# Niveau de sécurité minimum requis pour les mots de passe (0-4)
# 0 = Très faible, 1 = Faible, 2 = Moyen, 3 = Fort, 4 = Très fort
# Par défaut : 2 (Moyen)
PASSWORD_MIN_STRENGTH=2

# Longueur minimale des mots de passe
# Par défaut : 8 caractères
PASSWORD_MIN_LENGTH=8

# Activer la vérification de force en temps réel
# Par défaut : true
PASSWORD_STRENGTH_CHECK=true

# Configuration email pour les notifications
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your-email@gmail.com
MAIL_FROM_NAME="GestVentes EGBC"

# URL de l'application (pour les liens dans les emails)
APP_URL=http://localhost:8000

# Configuration de la base de données pour l'audit
DB_LOG_PASSWORD_RESETS=true

# Activer les statistiques de sécurité
SECURITY_STATS_ENABLED=true

# Période de rétention des logs de sécurité (en jours)
# Par défaut : 90 jours
SECURITY_LOGS_RETENTION=90
